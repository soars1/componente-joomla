<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
    <name>COM_PROJETOS_TITLE</name>
    <creationDate>October 2026</creationDate>
    <author>Gabriel Soares</author>
    <license>GPL-2.0-or-later</license>
    <version>0.1.1</version>
    <description>COM_PROJETOS_XML_DESCRIPTION</description>
    <element>com_projetos</element>
    <namespace path="src">Gabriel\Component\Projetos</namespace>

    <files folder="components/com_projetos">
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <administration>
        <menu>COM_PROJETOS</menu>

        <files folder="administrator/components/com_projetos">
            <folder>services</folder>
            <folder>sql</folder>
        </files>

        <languages folder="administrator/components/com_projetos/language">
            <language tag="pt-BR">pt-BR/com_projetos.ini</language>
            <language tag="pt-BR">pt-BR/com_projetos.sys.ini</language>
        </languages>
    </administration>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
</extension>